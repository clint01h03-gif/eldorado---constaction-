# ELDORADO Construction ERP - Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eldorado_erp?schema=public"

# NextAuth / Auth (replace with your preferred solution)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-here"

# App
NEXT_PUBLIC_APP_NAME="ELDORADO Construction ERP"
NEXT_PUBLIC_DEFAULT_CURRENCY="LKR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Colombo"
NEXT_PUBLIC_DATE_FORMAT="DD/MM/YYYY"

# Optional: Object storage for documents (S3-compatible)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
